# Copy to .env and adjust. Never commit the real .env.
PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://lnd:lnd_dev_password@localhost:5432/lnd

# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (Angular dev server + Capacitor)
CORS_ORIGINS=http://localhost:4200,capacitor://localhost,http://localhost
