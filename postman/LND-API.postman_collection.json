            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/feedback?targetType=VIDEO&targetId={{videoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "feedback"],
              "query": [
                { "key": "targetType", "value": "VIDEO" },
                { "key": "targetId", "value": "{{videoId}}" }
              ]
            }
          }
        },
